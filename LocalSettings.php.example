<?php
# davispedia-backend/LocalSettings.php

# Protect against web entry
if ( !defined( 'MEDIAWIKI' ) ) {
    exit;
}

$wgSitename = "Davispedia Local Dev";
$wgScriptPath = "";
$wgServer = "http://localhost:8080";

# Database settings (SQLite)
$wgDBtype = "sqlite";
$wgDBserver = "";
$wgDBname = "my_wiki";
$wgDBuser = "";
$wgDBpassword = "";
$wgSQLiteDataDir = "/var/www/html/data";

# Load the default Vector skin
wfLoadSkin( 'Vector' );
$wgDefaultSkin = 'vector-2022';

# Load custom extensions
wfLoadExtension( 'DavispediaFrontend', "$IP/extensions/DavispediaFrontend/extension.json" );
if ( is_dir( "$IP/extensions/Cowlender" ) ) {
    wfLoadExtension( 'Cowlender' );
}

wfLoadExtension( 'PictureOfTheDay' );

# Object cache (required for StopForumSpam IP deny-list caching across CLI/web)
$wgMainCacheType = CACHE_DB;

# Anti-spam extensions
wfLoadExtension( 'AbuseFilter' );

if ( is_dir( "$IP/extensions/StopForumSpam" ) ) {
    wfLoadExtension( 'StopForumSpam' );
    $wgSFSIPListLocation = 'https://www.stopforumspam.com/downloads/listed_ip_30_ipv46_all.gz';
    $wgSFSValidateIPListLocationMD5 = 'https://www.stopforumspam.com/downloads/listed_ip_30_ipv46_all.gz.md5';
    $wgSFSIPThreshold = 5;
    $wgSFSReportOnly = false;
}

wfLoadExtensions( [ 'ConfirmEdit', 'ConfirmEdit/QuestyCaptcha' ] );
$wgCaptchaClass = 'QuestyCaptcha';

// Add your questions in LocalSettings.php using this format:
$wgCaptchaQuestions = [
	'What city is this wiki based on?' => 'Davis',
	'What is the capital of California?' => 'Sacramento',
	'What is the name of this wiki?' => $wgSitename, // You can use variables
];

$wgCaptchaTriggers['edit']          = true;
$wgCaptchaTriggers['create']        = true;
$wgCaptchaTriggers['addurl']        = true;
$wgCaptchaTriggers['createaccount'] = true;
$wgCaptchaTriggers['badlogin']      = true;
$wgGroupPermissions['autoconfirmed']['skipcaptcha'] = true;

# Tell MediaWiki to inject your React bundle onto every page
$wgHooks['BeforePageDisplay'][] = function( OutputPage $out, Skin $skin ) {
    $out->addModules( 'ext.davispedia.frontend' );
};